# Mint kernel configuration
CONFIG_MINT=y
# CONFIG_MINT_SESL is not set

# SCSC WLAN options
# CONFIG_SCSC_WLBTD is not set
CONFIG_SCSC_WLAN_MAC_ADDRESS_FILENAME="/mnt/vendor/efs/wifi/.mac.info"
CONFIG_SCSC_WLAN_MAX_INTERFACES=12
CONFIG_SCSC_AP_INTERFACE_NAME="wlan1"

# SELinux Enforcing disabled by default for GSI/AOSP compatibility
# CONFIG_ALWAYS_ENFORCE is not set
